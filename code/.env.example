# FastAPI defaults to a SQLite DB beside the backend package. Set this only if needed.
# GHOSTGUARD_DATABASE_URL=sqlite:///backend/ghostguard.sqlite3
GHOSTGUARD_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173
LOG_LEVEL=INFO

# Optional AI explanations. No model call occurs until the user clicks â€œExplain with AIâ€.
# Use an OpenAI-compatible Chat Completions endpoint. Never commit the real key.
LLM_PROVIDER=OpenAI-compatible
LLM_BASE_URL=https://api.openai.com/v1

LLM_API_KEY=
# Optional full endpoint override, for example a compatible gateway URL.
# LLM_CHAT_COMPLETIONS_URL=
